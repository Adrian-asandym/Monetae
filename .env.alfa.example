# Plantilla para alfa (https://alfa-monetae.asandym.dev). Copiar a .env en el servidor de
# producción y reemplazar TODOS los valores REEMPLAZAR antes de arrancar. Nunca versionar el .env.
# Esquema: Cloudflare (proxied) -> Caddy en el host (TLS) -> 127.0.0.1:8090 -> nginx (web) -> api.
POSTGRES_USER=monetae
POSTGRES_DB=monetae
POSTGRES_PASSWORD=REEMPLAZAR-contrasena-larga-aleatoria
# La misma contraseña que POSTGRES_PASSWORD; db:5432 es el servicio interno de Compose.
MONETAE_DATABASE_URL=postgresql+psycopg://monetae:REEMPLAZAR-contrasena-larga-aleatoria@db:5432/monetae
# prod exige un secreto real (no "fake-...", 32+ caracteres) y cookies Secure.
MONETAE_ENVIRONMENT=prod
# Origen público exacto: CORS y comprobación de Origin del CSRF.
MONETAE_CORS_ORIGINS=["https://alfa-monetae.asandym.dev"]
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MONETAE_SECRET_KEY=REEMPLAZAR-secreto-aleatorio-de-al-menos-32-caracteres
MONETAE_COOKIE_SECURE=true
MONETAE_SESSION_IDLE_MINUTES=20160
MONETAE_SESSION_ABSOLUTE_DAYS=30
