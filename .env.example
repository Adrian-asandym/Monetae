# Solo ejemplos falsos para desarrollo local; cambiar antes de usar datos reales.
# Credenciales de PostgreSQL usadas por Compose.
POSTGRES_USER=monetae
POSTGRES_DB=monetae
POSTGRES_PASSWORD=change-me
# URL síncrona: db:5432 es el servicio de Compose; fuera de Docker usar 127.0.0.1:5433.
MONETAE_DATABASE_URL=postgresql+psycopg://monetae:change-me@db:5432/monetae
# Entorno permitido: local, test o prod.
MONETAE_ENVIRONMENT=local
# Lista JSON de orígenes exactos; [] deshabilita el acceso entre orígenes.
MONETAE_CORS_ORIGINS=[]
# Valor FALSO de desarrollo: sustituir por un secreto aleatorio de al menos 32 caracteres.
MONETAE_SECRET_KEY=fake-local-key-change-before-production-0000
MONETAE_COOKIE_SECURE=true
MONETAE_SESSION_IDLE_MINUTES=20160
MONETAE_SESSION_ABSOLUTE_DAYS=30
